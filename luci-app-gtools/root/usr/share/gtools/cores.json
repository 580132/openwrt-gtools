{
  "honk": {
    "title": "honk",
    "description": "eBPF transparent proxy engine (honk-core)",
    "repo": "daeuniverse/honk",
    "binary": "/usr/bin/honk-core",
    "service": "honk",
    "service_config": "honk",
    "service_section": "config",
    "service_enabled": "enabled",
    "channels": ["auto", "stable", "beta", "debug"],
    "defaults": {
      "enabled": true,
      "channel": "auto",
      "variant": "full",
      "allocator": "mimalloc"
    },
    "asset": {
      "archive": "tar.gz",
      "binary_name": "honk-core",
      "pattern": "honk-core-{tag}-{arch}-unknown-linux-{libc}{alloc}{variant}.tar.gz",
      "debug_pattern": "honk-core-debug-{arch}-unknown-linux-{libc}{alloc}{variant}.tar.gz",
      "debug_prefix": "debug.",
      "libc": "musl",
      "arch": {
        "x86_64": "x86_64",
        "aarch64": "aarch64"
      },
      "variants": {
        "full": ["-full", ""],
        "clash-api": ["-clash-api"],
        "native-api": ["-native-api"]
      },
      "allocators": {
        "mimalloc": [""],
        "stock": ["-stock"]
      }
    }
  },
  "cloudflared": {
    "title": "cloudflared",
    "description": "Cloudflare Tunnel client (cloudflared)",
    "repo": "cloudflare/cloudflared",
    "binary": "/usr/bin/cloudflared",
    "service": "cloudflared",
    "service_config": "cloudflared",
    "service_section": "config",
    "service_enabled": "enabled",
    "version_field": 3,
    "channels": ["stable"],
    "defaults": {
      "enabled": true,
      "channel": "stable",
      "variant": "default",
      "allocator": "default"
    },
    "asset": {
      "archive": "binary",
      "binary_name": "cloudflared",
      "pattern": "cloudflared-linux-{arch}",
      "libc": "",
      "arch": {
        "x86_64": "amd64",
        "aarch64": "arm64"
      },
      "variants": {
        "default": [""]
      },
      "allocators": {
        "default": [""]
      }
    }
  }
}
